#include <stdio.h>
#include <math.h>

#define MAX 100

/* ====== FUNCTION PROTOTYPES ====== */
void inputArray(int a[], int *n);
void outputArray(int a[], int n);
void printDescending(int a[], int n);
int checkAllOdd(int a[], int n);
void searchValue(int a[], int n);
int isPrime(int x);
void printPrimeElements(int a[], int n);
int confirmExit();

/* ====== MAIN FUNCTION ====== */
int main() {
    int a[MAX];
    int n = 0;
    int choice;

    do {
        printf("\n===== MENU =====\n");
        printf("1. Input the array\n");
        printf("2. Output the array\n");
        printf("3. Print array in descending order\n");
        printf("4. Check if all elements are odd\n");
        printf("5. Search a value\n");
        printf("6. Display prime numbers in the array\n");
        printf("7. Quit\n");
        printf("Choose an option: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                inputArray(a, &n);
                break;
            case 2:
                outputArray(a, n);
                break;
            case 3:
                printDescending(a, n);
                break;
            case 4:
                if (checkAllOdd(a, n))
                    printf("All elements are odd numbers.\n");
                else
                    printf("Not all elements are odd numbers.\n");
                break;
            case 5:
                searchValue(a, n);
                break;
            case 6:
                printPrimeElements(a, n);
                break;
            case 7:
                if (confirmExit())
                    return 0;
                break;
            default:
                printf("Invalid choice! Please try again.\n");
        }
    } while (1);

    return 0;
}

/* ====== FUNCTION DEFINITIONS ====== */

/* Function 1: Input array */
void inputArray(int a[], int *n) {
    do {
        printf("Enter number of elements (1 - 100): ");
        scanf("%d", n);
    } while (*n < 1 || *n > MAX);

    for (int i = 0; i < *n; i++) {
        printf("a[%d] = ", i);
        scanf("%d", &a[i]);
    }
}

/* Function 2: Output array */
void outputArray(int a[], int n) {
    if (n == 0) {
        printf("Array is empty.\n");
        return;
    }

    printf("Array elements: ");
    for (int i = 0; i < n; i++) {
        printf("%d ", a[i]);
    }
    printf("\n");
}

/* Function 3: Print array in descending order */
void printDescending(int a[], int n) {
    int temp[MAX];

    for (int i = 0; i < n; i++)
        temp[i] = a[i];

    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (temp[i] < temp[j]) {
                int t = temp[i];
                temp[i] = temp[j];
                temp[j] = t;
            }
        }
    }

    printf("Array in descending order: ");
    for (int i = 0; i < n; i++) {
        printf("%d ", temp[i]);
    }
    printf("\n");
}

/* Function 4: Check if all elements are odd */
int checkAllOdd(int a[], int n) {
    for (int i = 0; i < n; i++) {
        if (a[i] % 2 == 0)
            return 0;
    }
    return 1;
}

/* Function 5: Search a value */
void searchValue(int a[], int n) {
    int x, count = 0;
    printf("Enter value to search: ");
    scanf("%d", &x);

    for (int i = 0; i < n; i++) {
        if (a[i] == x)
            count++;
    }

    printf("Value %d appears %d time(s) in the array.\n", x, count);
}

/* Function 6: Check prime number */
int isPrime(int x) {
    if (x < 2)
        return 0;
    for (int i = 2; i <= sqrt(x); i++) {
        if (x % i == 0)
            return 0;
    }
    return 1;
}

/* Function 6: Print prime numbers */
void printPrimeElements(int a[], int n) {
    int found = 0;
    printf("Prime numbers in the array: ");
    for (int i = 0; i < n; i++) {
        if (isPrime(a[i])) {
            printf("%d ", a[i]);
            found = 1;
        }
    }

    if (!found)
        printf("None");
    printf("\n");
}

/* Function 7: Confirm exit */
int confirmExit() {
    int confirm;
    printf("Are you sure? Enter 1 to exit, 0 to continue: ");
    scanf("%d", &confirm);
    return confirm == 1;
}
